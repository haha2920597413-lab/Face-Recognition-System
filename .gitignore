# # =========================
# # Generated gallery data
# # 特征库可由 pipeline 重新构建，默认不提交
# # 若需一并上传特征库，请删除下面两行
# # =========================
# gallery/gallery_features.npy

# # =========================
# # Privacy-sensitive data
# # 含真实人脸的原始数据与处理结果，默认不提交
# # 若仅上传脱敏示例数据，可删除下面两行
# # =========================
# raw/
# identities/

# # =========================
# # Local config overrides（可选）
